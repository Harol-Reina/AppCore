<Project>

  <!-- AppCore Custom Build Targets for NuGet Package Consumers -->

  <PropertyGroup>
    <AppCoreVersion>1.0.0</AppCoreVersion>
    <AppCorePath>$(MSBuildThisFileDirectory)../../</AppCorePath>
  </PropertyGroup>

  <!-- NativeAOT Configuration Warnings -->
  <Target Name="AppCoreAotWarning" BeforeTargets="BeforeBuild" Condition="'$(PublishAot)' == 'true'">
    <Message Text="AppCore: NativeAOT compilation enabled. Ensure you're using JSON Source Generators." Importance="high" />
  </Target>

  <!-- Validation for required dependencies -->
  <Target Name="AppCoreValidateDependencies" BeforeTargets="BeforeBuild">
    <Warning Condition="'$(TargetFramework)' != 'net10.0' AND '$(TargetFramework)' != 'net9.0' AND '$(TargetFramework)' != 'net8.0'"
             Text="AppCore is optimized for .NET 8.0 or higher. Current target: $(TargetFramework)" />
  </Target>

  <!-- Enable source generators for JSON serialization -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

</Project>
