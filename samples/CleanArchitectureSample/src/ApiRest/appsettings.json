{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.NewRelic.Logs",
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ 
      {
        "Name": "WithProperty",
        "Args": { "name": "XTraceID", "value": "{XTraceID}" }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { 
        "Name": "NewRelicLogs",
        "Args": {
          "applicationName": "Product",
          "licenseKey": "8d636af6406f86ba780183d5de97621bFFFFNRAL"
        }
      },
      { 
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] XTraceID {XTraceID} {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  },

  "Cors": {
    "Origins": [
      "http://*",
      "http://*.tuprimero.com.co"
    ]
  },
  
  "OpenApiInfo": {
    "Version": "V 1.0",
    "Title": "Clean Architecture - ApiRest (Api-Rest)",
    "Description": "Esta API será responsable de la distribución y autorización general de los datos.",
    "Contact": {
      "Name": "App",
      "Email": "desarrollo@tuprimero.com.co",
      "Url": "https://tuprimero.com.co/contact"
    },
    "Server": {
      "Url": "https://apites.App.com",
      "LocalUrl": "http://localhost:5109"
    }
  }
}
