{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DefaultConnection": "User ID=orion75;Password=Or10n1975;Host=localhost;Port=5432;Database=Prueba;;Pooling=true;Include Error Detail=true",
  "SchemaDB": "public",
  "PokemonHost": "https://pokeapi.co/api/v2/",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [
      {
        "Name": "WithProperty",
        "Args": {
          "name": "XTraceID",
          "value": "{XTraceID}"
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] XTraceID {XTraceID} {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "Origins": [
      "http://*"
    ]
  },
  "OpenApiInfo": {
    "Version": "V 1.0",
    "Title": "Clean Architecture - ApiRest (Api-Rest)",
    "Description": "Esta API será responsable de la distribución y autorización general de los datos.",
    "Contact": {
      "Name": "App",
      "Email": "desarrollo@orionsoft.com.co",
      "Url": "https://orionsoft.com.co/contact"
    },
    "Server": {
      "Url": "https://apites.App.com",
      "LocalUrl": "http://localhost:5109"
    }
  }
}