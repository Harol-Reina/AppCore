{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "DefaultConnection": "User ID=orion75;Password=Or10n1975;Host=localhost;Port=5432;Database=Prueba;;Pooling=true;Include Error Detail=true",
  "SchemaDB": "public",
  "PokemonHost": "https://pokeapi.co/api/v2/",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ 
      {
        "Name": "WithProperty",
        "Args": { "name": "XTraceID", "value": "{XTraceID}" }
      }
    ],
    "MinimumLevel": {
      "Default": "information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { 
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} Develop {Level:u3}] XTraceID: {XTraceID} {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  }
}
