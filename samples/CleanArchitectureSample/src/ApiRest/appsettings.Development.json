{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.NewRelic.Logs",
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ 
      {
        "Name": "WithProperty",
        "Args": { "name": "XTraceID", "value": "{XTraceID}" }
      }
    ],
    "MinimumLevel": {
      "Default": "information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { 
        "Name": "NewRelicLogs",
        "Args": {
          "applicationName": "Product",
          "licenseKey": "8d636af6406f86ba780183d5de97621bFFFFNRAL"
        }
      },
      { 
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} Develop {Level:u3}] XTraceID: {XTraceID} {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      }
    ]
  }
}
